# Copia este archivo como .env y cambia los valores. .env no se sube a git.
# Docker Compose lo lee automáticamente desde esta carpeta.

# Contraseña del usuario «admin» de Grafana (http://localhost:3000).
GRAFANA_ADMIN_PASSWORD=cambia-esta-contraseña

# Clave de Tavily para la búsqueda en internet (https://tavily.com, plan gratuito).
# Va también en el .env junto a Jarvis.exe. Sin clave se busca con DuckDuckGo.
TAVILY_API_KEY=
