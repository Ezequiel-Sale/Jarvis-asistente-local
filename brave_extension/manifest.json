{
  "manifest_version": 3,
  "name": "Jarvis para Brave",
  "version": "1.2.0",
  "description": "Deja que tu asistente Jarvis (en esta PC) lea la pestaña activa y toque sus botones y campos cuando se lo pedís, y pulsa «Omitir intro/créditos» en Crunchyroll y otros sitios de series. Solo habla con 127.0.0.1.",
  "permissions": [
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "120",
  "content_scripts": [
    {
      "matches": [
        "https://*.crunchyroll.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.disneyplus.com/*",
        "https://*.max.com/*",
        "https://*.paramountplus.com/*"
      ],
      "js": [
        "saltar.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
