<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Saber si hay Wi-Fi para elegir la calidad de la pantalla en vivo. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Actualizarse sola con el APK que ofrece la PC (Android pide confirmar cada vez). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Huella para abrir la app y para aprobar acciones de riesgo alto. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Avisos con la app cerrada: servicio en primer plano y notificaciones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- usesCleartextTraffic: la conexión va siempre por Tailscale, que ya la cifra (WireGuard). -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/JarvisTheme"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Pantallas de la PC en vivo: se puede girar el celular para verlas en horizontal. -->
        <activity
            android:name=".ScreenActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
        <receiver
            android:name=".NotifyReceiver"
            android:exported="false" />
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- dataSync: escuchar avisos; microphone: hablar con el botón de los auriculares. -->
        <service
            android:name=".JarvisService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />
    </application>
</manifest>
