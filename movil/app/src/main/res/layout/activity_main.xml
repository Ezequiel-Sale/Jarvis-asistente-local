<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="J.A.R.V.I.S."
            android:textColor="@color/cyan"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:text="● CONECTANDO…"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ver las pantallas de la PC"
            android:gravity="center"
            android:text="🖥"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="⋮"
            android:textColor="@color/text"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Vinculación (primera vez) -->
    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vincular con tu PC"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="1. Activa Tailscale en este celular.\n2. En Jarvis (PC): Ajustes → App del celular → actívala y pulsa «VINCULAR CELULAR».\n3. Escribe aquí la dirección y el código que muestra."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="monospace"
                android:text="DIRECCIÓN"
                android:textColor="@color/cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="100.x.x.x:8765"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:text="CÓDIGO DE 6 CIFRAS"
                android:textColor="@color/cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="000000"
                android:importantForAutofill="no"
                android:inputType="number"
                android:letterSpacing="0.3"
                android:maxLength="7"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <Button
                android:id="@+id/pair"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/cyan"
                android:text="VINCULAR"
                android:textColor="@color/bg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setup_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/error"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Chat -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Escribe una orden…"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/mic"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/panel_light"
            android:text="🎙"
            android:textSize="18sp" />

        <Button
            android:id="@+id/send"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/cyan_dark"
            android:text="➤"
            android:textColor="@color/cyan"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
